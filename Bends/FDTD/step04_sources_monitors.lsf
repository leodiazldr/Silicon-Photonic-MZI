# Two S-parameter ports on the leads, and a 2D field profile over the bend.
# Port numbering: 1 input, 2 output.
#
# The bend is single mode at both ends, so the two port modes carry the transmission and
# the reflection. FDTD excites one port mode at a time, chosen by the port group's active
# source, which must be the input port ("in"); that gives the S-column for input
# excitation, and reciprocity gives the reverse direction.

# before running check the working directory: File -> Change working directory

############# Ports #################
addport;
set("name", "in");
set("injection axis", "x-axis");
set("direction", "Forward");
set("x", x_in_port + 2*um);
set("y", 0);
set("y span", wg_width + 1*um);
set("z", wg_thickness/2);
set("z span", wg_thickness + 1*um);
set("mode selection", "fundamental TE mode");

addport;
set("name", "out");
set("injection axis", "x-axis");
set("direction", "Backward");
set("x", x_out_port - 1*um);
set("y", y_out);
set("y span", wg_width + 1*um);
set("z", wg_thickness/2);
set("z span", wg_thickness + 1*um);
set("mode selection", "fundamental TE mode");

select("FDTD::ports");
set("monitor frequency points", 101);

setglobalsource("center wavelength", lambda0);
setglobalsource("wavelength span", wavelength_span);

setglobalmonitor("frequency points", 1);
##########################################

############# Monitors #################
addprofile;
set("name", "monitor");
set("monitor type", 7);          # 2D X-normal
set("x min", x_in_port + 1*um);
set("x max", x_out_port);
set("y min", y_min_cell + 1*um);
set("y max", y_max_cell - 1*um);
set("z", wg_thickness/2);
##########################################
