# Setup: units, material names, and the frozen MMI design point.
#
# The design point is imported from ../MODE/mmi_design_point.mat, written by the MODE
# flow's step14_save_design.lsf. Coordinates follow the MODE flow: x = propagation, 0 at
# the start of the MMI body; y = lateral; z = vertical, 0 at the BOX/silicon interface.

# before running check the working directory: File -> Change working directory

switchtolayout;
deleteall;

addpath("../../shared");
materials;
clear;

# units
um = 1e-6;
nm = 1e-9;

# material names (match ../MODE/step01_setup.lsf)
wg_material   = "Si (Silicon) - Dispersive & Lossless";
box_material  = "SiO2 (Glass) - Const";
clad_material = "SiO2 (Glass) - Const";

# frozen design point: geometry values and the sweep optima
matlabload("../MODE/mmi_design_point.mat");
