# Geometry construction: the full MMI structure group (input waveguide, input
# taper, MMI body, output tapers and waveguides, BOX and cladding), in x-y.

# before running check the working directory: File -> Change working directory

############# Coordinate reference (x = propagation) #################
# x = -L_taper_in          : start of input taper
# x = 0                    : start of MMI body
# x = L_MMI                : end of MMI body
# x = L_MMI + L_taper_out  : end of output tapers
##########################################

x_taper_start  = -L_taper_in;
x_mmi_start    = x_taper_start + L_taper_in;
x_mmi_end      = x_mmi_start   + L_MMI;
x_taper_end    = x_mmi_end     + L_taper_out;

x_in_port      = x_taper_start - L_in_wg;
x_out_port     = x_taper_end   + L_out_wg;

addstructuregroup;
set("name", "MMI");
set("x", 0);
set("y", 0);
set("z", 0);

############# Structure #################
# input waveguide
addrect;
set("name", "input_wg");
set("material", wg_material);
set("x min", x_in_port);
set("x max", x_taper_start);
set("y", 0);
set("y span", wg_width);
set("z min", 0);
set("z max", wg_thickness);
addtogroup("MMI");

# input taper, wg_width -> wg_width_out_initial
addpoly;
set("name", "input_taper");
set("material", wg_material);
V_in_taper = [ x_taper_start, -wg_width / 2;
               x_mmi_start,   -wg_width_out_initial    / 2;
               x_mmi_start,    wg_width_out_initial    / 2;
               x_taper_start,  wg_width / 2 ];
set("vertices", V_in_taper);
set("x", 0);
set("y", 0);
set("z min", 0);
set("z max", wg_thickness);
addtogroup("MMI");

# MMI body
addrect;
set("name", "mmi_body");
set("material", wg_material);
set("x min", x_mmi_start);
set("x max", x_mmi_end);
set("y", 0);
set("y span", W_MMI);
set("z min", 0);
set("z max", wg_thickness);
addtogroup("MMI");

# output tapers, wg_width_out_initial -> wg_width, centred at y = +/-dy
addpoly;
set("name", "output_taper_top");
set("material", wg_material);
V_out_taper_top = [ x_mmi_end,   dy - wg_width_out_initial / 2;
                    x_taper_end,  dy - wg_width           / 2;
                    x_taper_end,  dy + wg_width           / 2;
                    x_mmi_end,    dy + wg_width_out_initial / 2 ];
set("vertices", V_out_taper_top);
set("x", 0);
set("y", 0);
set("z min", 0);
set("z max", wg_thickness);
addtogroup("MMI");

addpoly;
set("name", "output_taper_bottom");
set("material", wg_material);
V_out_taper_bottom = [ x_mmi_end,   -dy - wg_width_out_initial / 2;
                       x_taper_end,  -dy - wg_width           / 2;
                       x_taper_end,  -dy + wg_width           / 2;
                       x_mmi_end,    -dy + wg_width_out_initial / 2 ];
set("vertices", V_out_taper_bottom);
set("x", 0);
set("y", 0);
set("z min", 0);
set("z max", wg_thickness);
addtogroup("MMI");

# output waveguides
addrect;
set("name", "output_wg_top");
set("material", wg_material);
set("x min", x_taper_end);
set("x max", x_out_port);
set("y",  dy);
set("y span", wg_width);
set("z min", 0);
set("z max", wg_thickness);
addtogroup("MMI");

addrect;
set("name", "output_wg_bottom");
set("material", wg_material);
set("x min", x_taper_end);
set("x max", x_out_port);
set("y", -dy);
set("y span", wg_width);
set("z min", 0);
set("z max", wg_thickness);
addtogroup("MMI");

# buried oxide
addrect;
set("name", "box");
set("material", box_material);
set("x min", x_in_port - 1*um);
set("x max", x_out_port + 1*um);
set("y min", -W_MMI - 4*um);
set("y max",  W_MMI + 4*um);
set("z min", -box_depth);
set("z max", 0);
set("alpha", 0.15);
addtogroup("MMI");

# cladding
addrect;
set("name", "cladding");
set("material", clad_material);
set("x min", x_in_port - 1*um);
set("x max", x_out_port + 1*um);
set("y min", -W_MMI - 4*um);
set("y max",  W_MMI + 4*um);
set("z min", 0);
set("z max", wg_thickness + clad_height);
set("override mesh order from material database", true);
set("mesh order", 3);
set("alpha", 0.15);
addtogroup("MMI");
##########################################
