# MMI length sweep: +/-20% of the current L_MMI, run as an EME propagation sweep
# so the mode decomposition is reused instead of rebuilding the geometry.

# before running check the working directory: File -> Change working directory

?"";
?"Sweeping MMI length (this is fast, EME reuses the mode decomposition)...";

############# Sweep #################
N_sweep     = 31;
L_sweep_min = L_MMI * 0.80;
L_sweep_max = L_MMI * 1.20;

setemeanalysis("propagation sweep", true);
setemeanalysis("parameter", "group span 3");   # group 3 = MMI body
setemeanalysis("start", L_sweep_min);
setemeanalysis("stop", L_sweep_max);
setemeanalysis("number of points", N_sweep);

emesweep;

S_sweep = getemesweep("S");

L_sweep_vec = S_sweep.group_span_3;
T_top_vs_L  = abs(S_sweep.s12)^2;
T_bot_vs_L  = abs(S_sweep.s13)^2;

IL_vs_L     = matrix(N_sweep, 1);

for (i = 1:N_sweep) {
    T_top   = T_top_vs_L(i);
    T_bot   = T_bot_vs_L(i);
    L_test  = L_sweep_vec(i);

    T_sum = T_top + T_bot;
    if (T_sum < 1e-30) { T_sum = 1e-30; }
    IL_vs_L(i) = -10 * log10(T_sum);
}

plot(L_sweep_vec, IL_vs_L);
##########################################

############# Save #################
matlabsave("length_sweep.mat", L_sweep_vec, T_top_vs_L, T_bot_vs_L, IL_vs_L);
?"Length sweep saved to length_sweep.mat";
##########################################

############# Results #################
min_IL       = min(IL_vs_L);
idx_opt      = find(IL_vs_L, min_IL);
L_opt        = L_sweep_vec(idx_opt);

T_top_opt    = T_top_vs_L(idx_opt);
T_bot_opt    = T_bot_vs_L(idx_opt);

# imbalance at the optimum (dB); 0 = perfect 50:50
Imb_opt = abs(10 * log10(T_top_opt / T_bot_opt));

?"";
?"==============================================";
?"  MMI Length Sweep Results";
?"==============================================";
?"  Analytical L_MMI      : " + num2str(L_MMI/um,    "%.2f") + " um";
?"  Best L (min IL)        : " + num2str(L_opt/um,  "%.2f") + " um";
?"";
?"  At min-loss length:";
?"    T_top  = " + num2str(T_top_opt, "%.4f") + "  (" + num2str(10*log10(T_top_opt), "%.2f") + " dB)";
?"    T_bot  = " + num2str(T_bot_opt, "%.4f") + "  (" + num2str(10*log10(T_bot_opt), "%.2f") + " dB)";
?"    IL     = " + num2str(min_IL,    "%.3f") + " dB";
?"    Imb    = " + num2str(Imb_opt,   "%.3f") + " dB";
?"==============================================";
?"";
##########################################

############# Rebuild #################
switchtolayout;

x_mmi_end_opt   = x_mmi_start + L_opt;
x_taper_end_opt = x_mmi_end_opt + L_taper_out;
x_out_port_opt  = x_taper_end_opt + L_out_wg;

setnamed("MMI::mmi_body", "x max", x_mmi_end_opt);
setnamed("mesh_mmi", "x max", x_mmi_end_opt);

V_out_taper_top = [ x_mmi_end_opt,   dy - wg_width_in_end / 2;
                    x_taper_end_opt,  dy - wg_width           / 2;
                    x_taper_end_opt,  dy + wg_width           / 2;
                    x_mmi_end_opt,    dy + wg_width_in_end / 2 ];
setnamed("MMI::output_taper_top", "vertices", V_out_taper_top);
setnamed("mesh_output_taper_top", "x min", x_mmi_end_opt);
setnamed("mesh_output_taper_top", "x max", x_taper_end_opt);

V_out_taper_bottom = [ x_mmi_end_opt,   -dy - wg_width_in_end / 2;
                       x_taper_end_opt,  -dy - wg_width           / 2;
                       x_taper_end_opt,  -dy + wg_width           / 2;
                       x_mmi_end_opt,    -dy + wg_width_in_end / 2 ];
setnamed("MMI::output_taper_bottom", "vertices", V_out_taper_bottom);
setnamed("mesh_output_taper_bottom", "x min", x_mmi_end_opt);
setnamed("mesh_output_taper_bottom", "x max", x_taper_end_opt);

setnamed("MMI::output_wg_top", "x min", x_taper_end_opt);
setnamed("MMI::output_wg_top", "x max", x_out_port_opt);
setnamed("mesh_output_wg_top", "x min", x_taper_end_opt);
setnamed("mesh_output_wg_top", "x max", x_out_port_opt);

setnamed("MMI::output_wg_bottom", "x min", x_taper_end_opt);
setnamed("MMI::output_wg_bottom", "x max", x_out_port_opt);
setnamed("mesh_output_wg_bottom", "x min", x_taper_end_opt);
setnamed("mesh_output_wg_bottom", "x max", x_out_port_opt);

setnamed("MMI::box", "x max", x_out_port_opt + 1*um);
setnamed("MMI::cladding", "x max", x_out_port_opt + 1*um);

# update the cell spans to the new geometry
span_1 = x_taper_start - x_in_port;
span_2 = x_mmi_start - x_taper_start;
span_3 = x_mmi_end_opt - x_mmi_start;
span_4 = x_taper_end_opt - x_mmi_end_opt;
span_5 = x_out_port_opt - x_taper_end_opt;

setnamed("EME", "group spans", [span_1; span_2; span_3; span_4; span_5]);
##########################################
