# Setup, units and design parameters: device dimensions, doping levels and bias
# sweep settings. Called by main.lsf; every later step depends on these globals.
#
# CHARGE's 2D solver works in x-y with z as a uniform "thickness":
#     x = lateral (across the waveguide width)
#     y = vertical (BOX / Si / cladding stack)
#     z = propagation (uniform thickness, dev_length)

# before running check the working directory: File -> Change working directory

switchtolayout;
deleteall;

# units
um = 1e-6;
nm = 1e-9;
cm = 1e-2;

# geometry (cross-section)
wg_width      = 0.5  * um;     # optical waveguide width (the mode lives here)
wg_thickness  = 220  * nm;     # SOI device layer thickness
box_depth     = 2.0  * um;     # buried oxide below the silicon
clad_height   = 2.0  * um;     # cladding above the silicon
slab_height    = 0.09 * um;     # slab that joins the ridge to the metal contacts
contact_height = 0.09 * um;    # metal thickness

lateral_half = 1.5  * um;      # lateral half-extent of the simulation
dev_length   = 1.0  * um;      # uniform thickness (z); arbitrary for a 2D solver

# doping (Lumerical works in m^-3: 1e24 m^-3 = 1e18 cm^-3)
N_A       = 2e23;              # acceptor density (p region)
N_D       = 1e23;              # donor density    (n region)
N_contact = 2e25;              # p+ / n+ contact regions

# junction position; offset = 0 puts it at the mode centre (max overlap, max loss)
junction_offset = 0.0 * nm;

# p+ / n+ contact region geometry
contact_outer = 2.0 * um;      # lateral width of each metal contact
contact_inner = 1.2 * um;      # distance from center where the contact regions begin

# bias convention: reverse bias, anode negative and cathode grounded. The anode
# sweeps from V_reverse_stop (equilibrium) to V_reverse_start (deep reverse).
V_cathode       =  0.0;        # V, cathode held at ground
V_reverse_stop  =  0.0;        # V, start of the sweep
V_reverse_start = -1.5;        # V, end of the sweep
V_num_points    = 21;          # number of bias points

x_junction = junction_offset;  # CHARGE x of the metallurgical junction
