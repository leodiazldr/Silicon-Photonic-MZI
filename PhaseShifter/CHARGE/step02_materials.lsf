# Materials: electrical models (semiconductor / insulator / conductor).
# "CT" and "HT" select the model imported from Lumerical's built-in library;
# "Sze" / "CRC" name the source of the parameter set.

# before running check the working directory: File -> Change working directory

############# Materials #################
# Silicon (semiconductor)
addmodelmaterial;
set("name", "Si (Silicon)");
addmaterialproperties("CT", "Si (Silicon)");
select("materials::Si (Silicon)");
addmaterialproperties("HT", "Si (Silicon)");
select("materials::Si (Silicon)");
set("color", [0.9; 0.1; 0; 0.9]);        # Red

# SiO2 for the BOX and cladding (insulator)
addmodelmaterial;
set("name", "SiO2 (Glass)");
addmaterialproperties("CT", "SiO2 (Glass) - Sze");
select("materials::SiO2 (Glass)");
addmaterialproperties("HT", "SiO2 (Glass) - Sze");
select("materials::SiO2 (Glass)");
set("color", [0.5; 0.5; 0.5; 1]);        # Grey

# Aluminium for the contacts (conductor)
addmodelmaterial;
set("name", "Al (Aluminium)");
addmaterialproperties("CT", "Al (Aluminium) - CRC");
select("materials::Al (Aluminium)");
addmaterialproperties("HT", "Al (Aluminium) - CRC");
select("materials::Al (Aluminium)");
set("color", [0.85; 0.88; 0.90; 1]);     # Grey
##########################################
