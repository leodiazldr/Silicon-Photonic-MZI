# Doping regions: two Pearson-IV implants in the ridge, two diffused blocks on the slab.
#
# The implanted p/n regions sit in the ridge and overlap the optical mode - that is
# where depletion happens, and the implant makes the doping fall away with depth.
# The heavily doped p+/n+ blocks sit out on the slab, away from the mode, to give a
# low-resistance path to the metal contacts.
#
# "concentration" is the block level (adddiffusion); "peak concentration" is the
# value at the top of the profile (addimplant). Both are in m^-3.

# before running check the working directory: File -> Change working directory

############# Doping #################
# p+ contact region (left)
adddiffusion;
set("name", "p_plus");
set("x min", -contact_outer - 0.3*um);
set("x max", -contact_inner + 0.3*um);
set("y min", 0);
set("y max", slab_height);
set("z", 0);
set("z span", dev_length);
set("dopant type", "p");
set("concentration", N_contact);
set("source face", "upper y");

# p region (acceptor, in the ridge)
addimplant;
set("name", "p_region");
V=[-contact_inner,-dev_length/2;x_junction,-dev_length/2;x_junction,dev_length/2;-contact_inner,dev_length/2]; # (um)
set("vertices",V);
set("x", 0);
set("y", wg_thickness);
set("z", 0);
set("dopant type", "p");
set("peak concentration", N_A);
set("distribution function", "pearson4");
set("range", wg_thickness/2);
set("surface normal","y");

# n region (donor, in the ridge)
addimplant;
set("name", "n_region");
V=[contact_inner,-dev_length/2;x_junction,-dev_length/2;x_junction,dev_length/2;contact_inner,dev_length/2]; # (um)
set("vertices",V);
set("x", 0);
set("y", wg_thickness);
set("z", 0);
set("dopant type", "n");
set("peak concentration", N_D);
set("distribution function", "pearson4");
set("range", wg_thickness/2);
set("surface normal","y");

# n+ contact region (right)
adddiffusion;
set("name", "n_plus");
set("x min", contact_inner - 0.3*um);
set("x max", contact_outer + 0.3*um);
set("y min", 0);
set("y max", slab_height);
set("z", 0);
set("z span", dev_length);
set("dopant type", "n");
set("concentration", N_contact);
set("source face", "upper y");
##########################################
