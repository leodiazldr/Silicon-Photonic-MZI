# PN junction carrier-depletion phase shifter - MODE (electro-optic).
# Effective index and loss versus bias, and the V_pi*L figure of merit.
#
# PREREQUISITE: run ../CHARGE/main.lsf first, so ../CHARGE/charge_params.mat (cross-section
# and bias grid) and ../CHARGE/charge_sweep.mat (carrier maps) exist.
# Post-processing: step06_export_interconnect (INTERCONNECT card), neff_vs_bias.py

# before running check the working directory: File -> Change working directory

############# Phase A: import the carrier maps #################
step01_setup;                  # units, imported geometry and bias grid, FDE window
step02_materials;              # charge dataset -> grid attribute -> perturbed Si
step03_geometry;               # BOX, slab, ridge, cladding, contacts
##########################################

############# Phase B: optical solver #################
step04_fde_setup;              # FDE region, mesh, modal settings, reference solve
##########################################

############# Phase C: run and export #################
step05_bias_sweep;             # solve the mode per bias point, save neff_vs_bias.mat
step06_export_interconnect;    # write the INTERCONNECT compact-model data card
##########################################

# Closing summary
?"";
?"==============================================";
?"  PN Junction, Task 3.2 Complete";
?"==============================================";
?"  Structural model : optical cross-section, same geometry as CHARGE";
?"  Carrier model    : imported np density, Soref and Bennett";
