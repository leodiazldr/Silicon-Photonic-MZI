# Setup: units, geometry, optical settings, bias grid.
#
# Geometry is copied from ../CHARGE/step01_setup.lsf so the imported carrier map
# lands on the right coordinates: x = lateral, 0 at the waveguide centre;
# y = vertical, 0 at the BOX/silicon interface.

# before running check the working directory: File -> Change working directory

switchtolayout;
deleteall;

addpath("../../shared");
materials;  # shared dispersive / constant-index models

clear;

# units
um = 1e-6;
nm = 1e-9;
cm = 1e-2;

# geometry (cross-section)
wg_width      = 0.5  * um;
wg_thickness  = 220  * nm;
box_depth     = 2.0  * um;
clad_height   = 2.0  * um;
slab_height    = 0.09 * um;
contact_height= 0.09 * um;
contact_inner = 1.2  * um;
contact_outer = 2.0  * um;

lateral_half  = 1.5  * um;     # CHARGE simulation half-extent; the FDE window matches it

z_extent      = 1.0  * um;     # arbitrary for a 2D solve, only needs to be shared

# optical settings
wavelength0 = 1.55 * um;
n_modes     = 1;               # fundamental TE only

# FDE window
fde_x_span   = 2*lateral_half;
fde_y_span   = 2*lateral_half;
fde_y_center = wg_thickness/2;
fde_bc       = "Metal";

# bias grid; must match ../CHARGE/step07_dc_sweep.lsf -- the bias index used to
# select a carrier map later is an index into that sweep
V_bias_start  = -1.5;
V_bias_stop   =  0.0;
V_bias_points = 21;

charge_file = "../CHARGE/charge_sweep.mat";
result_file = "neff_vs_bias.mat";
